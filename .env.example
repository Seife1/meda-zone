# ── MedaZone Environment Variables ─────────────────────────────
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Local dev: set DEV_HOST once — backend, admin web, and mobile all read it.
#   • Physical phone on Wi-Fi → your PC's LAN IP (ipconfig / ifconfig)
#   • Android emulator        → 10.0.2.2
#   • iOS simulator / same machine → 127.0.0.1

# ── Local dev machine ──────────────────────────────────────────
DEV_HOST=192.168.1.7
DEV_API_PORT=8001

# ── App ────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-char-random-string
ENVIRONMENT=development
DEBUG=false

# Public API base URL (used in payment webhook callbacks)
API_BASE_URL=http://localhost:8001

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_HOST=medazone_postgres
POSTGRES_PORT=5432
POSTGRES_DB=medazone
POSTGRES_USER=medazone
POSTGRES_PASSWORD=strong-db-password-here
DATABASE_URL=postgresql+asyncpg://medazone:strong-db-password-here@medazone_postgres:5432/medazone

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=medazone_redis
REDIS_PORT=6379
REDIS_PASSWORD=strong-redis-password-here
REDIS_URL=redis://:strong-redis-password-here@medazone_redis:6379/0

# ── CORS ───────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5174,http://localhost:3000,http://localhost:80

# ── Firebase (FCM + Admin Auth) ────────────────────────────────
# Path to your Firebase service account JSON file.
# See docs/firebase-setup.md for how to generate this.
FIREBASE_CREDENTIALS_PATH=../firebase-credentials.json

# ── Firebase Admin Web SDK (for admin-web/.env or Vite) ────────
# Copy these from Firebase Console → Project Settings → Your web app
VITE_FIREBASE_API_KEY=replace-with-your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-your-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-your-sender-id
VITE_FIREBASE_APP_ID=replace-with-your-app-id

# ── Chapa Payment Gateway ──────────────────────────────────────
# Get from: https://dashboard.chapa.co → Settings → API Keys
CHAPA_SECRET=
CHAPA_WEBHOOK_SECRET=
# Optional: override the webhook URL (defaults to API_BASE_URL/api/v1/payments/chapa/webhook)
CHAPA_WEBHOOK_URL=

# ── ArifPay Payment Gateway ────────────────────────────────────
# Get from: https://arifpay.net → Developer Hub → Sandbox
ARIFPAY_SECRET=
ARIFPAY_SANDBOX=true
ARIFPAY_BASE_URL=https://gateway.arifpay.net
